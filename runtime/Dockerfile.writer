ARG STORAGE_IMAGE
FROM ${STORAGE_IMAGE}
USER root
ARG COLUMNAR_EXPORT=false
COPY columnar-requirements.lock /opt/colvenna/columnar-requirements.lock
RUN if [ "$COLUMNAR_EXPORT" = true ]; then \
      python -m pip install --require-hashes --only-binary=:all: --no-cache-dir \
        -r /opt/colvenna/columnar-requirements.lock; \
    fi
COPY package/ /opt/colvenna/application/
COPY manifest.json /opt/colvenna/writer-build.json
RUN mkdir -p /work && chown 10001:10001 /work
ENV PYTHONPATH=/opt/colvenna/application PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
VOLUME ["/work"]
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "-m", "colvenna_isle.writer.runtime"]
